# =====================================
# Application
# =====================================
APP_NAME=FastAPI Boilerplate
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# Generate a new one for production!
SECRET_KEY=9_N6xE7Z0vQnM8LxR0m3eWv1M3lTQ5z1F6dXqO8nYkWbP2aC7sJr9LfV4nHx8QkM6sPjQkL5gVw

# =====================================
# Database (PostgreSQL)
# =====================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=fastapi_db

# SQLAlchemy
DATABASE_URL=postgresql+psycopg://postgres:postgres123@postgres:5432/fastapi_db

# If using SQLAlchemy Async
# DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/fastapi_db

# =====================================
# Redis
# =====================================
REDIS_PASSWORD=redis123

REDIS_URL=redis://:redis123@redis:6379/0

# =====================================
# JWT
# =====================================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =====================================
# pgAdmin
# =====================================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123

# =====================================
# Logging
# =====================================
LOG_LEVEL=INFO