# Copy to .env.prod ON THE SERVER and fill with REAL, NEWLY-GENERATED secrets.
# Never commit .env.prod. Generate fresh values — do not reuse local dev secrets.

# --- Postgres (internal only) ---
POSTGRES_USER=authforge_app
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=authforge
# host is the compose service name 'postgres', not localhost
DATABASE_URL=postgresql+psycopg://authforge_app:CHANGE_ME_strong_random@postgres:5432/authforge

# --- Redis (internal only) ---
REDIS_PASSWORD=CHANGE_ME_strong_random
REDIS_URL=redis://:CHANGE_ME_strong_random@redis:6379/0

# --- App / JWT ---
APP_NAME=authforge
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MFA (Fernet key; MUST differ from SECRET_KEY) ---
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=CHANGE_ME_generated_fernet_key=

# --- Logging ---
LOG_LEVEL=INFO
